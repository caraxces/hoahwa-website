# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/hoahwa-images-export/

# Archives. Two site backups (789 MB and 757 MB) were committed here once and
# had to be stripped from history with git-filter-repo — GitHub rejects any
# file over 100 MB, so the whole repo became unpushable. Keep backups outside
# the working tree.
*.zip

# production
/build

# misc
.DS_Store
.cursor/

# generated assets (optional local)
/assets/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# Hostinger contact API credentials (generated at deploy time)
public/api/config.php

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
